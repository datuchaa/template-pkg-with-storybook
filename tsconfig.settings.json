{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Node",
    "types": [],
    "sourceMap": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true
  }
}
